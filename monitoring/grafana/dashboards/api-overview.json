{
  "title": "TaskManager - API Overview",
  "timezone": "browser",
  "panels": [
    {
      "title": "Request Rate",
      "type": "graph",
      "targets": [{ "expr": "sum(rate(http_requests_total{job=\"taskmanager-backend\"}[5m]))" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "title": "Error Rate (5xx)",
      "type": "graph",
      "targets": [{ "expr": "sum(rate(http_requests_total{job=\"taskmanager-backend\", status=~\"5..\"}[5m]))" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "p95 Latency",
      "type": "graph",
      "targets": [{ "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"taskmanager-backend\"}[5m]))" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "title": "Memory Usage",
      "type": "graph",
      "targets": [{ "expr": "process_resident_memory_bytes{job=\"taskmanager-backend\"}" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "title": "CPU Usage",
      "type": "graph",
      "targets": [{ "expr": "rate(process_cpu_seconds_total{job=\"taskmanager-backend\"}[5m])" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },
    {
      "title": "Pod Restarts",
      "type": "graph",
      "targets": [{ "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"taskmanager\"}[1h])" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
